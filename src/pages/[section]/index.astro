---
import Base from '../../layouts/Base.astro';
import EntryRow from '../../components/EntryRow.astro';
import { sections, getSection, type SectionKey } from '../../lib/site';

export async function getStaticPaths() {
  return sections.map((s) => ({ params: { section: s.key }, props: { section: s } }));
}

const { section } = Astro.props;
const items = await getSection(section.key as SectionKey);
---

<Base title={section.label} description={section.intro}>
  <header class="page-head">
    <h1>
      {section.label}
      <span class="ko">{section.labelKo}</span>
    </h1>
    <p class="intro">{section.intro}</p>
  </header>

  <ul class="entries">
    {items.map((entry) => <EntryRow section={section.key} entry={entry} />)}
  </ul>
</Base>

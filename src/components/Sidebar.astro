---
import { site, sections, getCounts, href } from '../lib/site';
const counts = await getCounts();
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isActive = (p: string) => path.startsWith(`${base}${p}`);
---

<aside class="sidebar">
  <div class="name">
    <a href={href('/')}>{site.name}</a>
    <small>{site.nameKo}</small>
  </div>

  <div class="statement">
    <p>{site.statement}</p>
    <p class="ko">{site.statementKo}</p>
  </div>

  <nav class="nav" aria-label="Sections">
    <ul>
      {sections.map((s) => (
        <li>
          <a href={href(`/${s.key}/`)} aria-current={isActive(`/${s.key}/`) ? 'page' : undefined}>
            {s.label}
          </a>
          <span class="count">{counts[s.key]}</span>
        </li>
      ))}
      <li class="secondary">
        <a href={href('/about/')} aria-current={isActive('/about/') ? 'page' : undefined}>About / CV</a>
      </li>
    </ul>
  </nav>

  <div class="contact">
    <div><a href={`mailto:${site.email}`}>{site.email}</a></div>
    <div>{site.city}</div>
    <div>Updated {site.updated}</div>
  </div>
</aside>

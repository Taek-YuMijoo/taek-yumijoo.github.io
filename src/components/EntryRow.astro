---
import { Image } from 'astro:assets';
import { href, type SectionKey, type Work } from '../lib/site';

interface Props {
  section: SectionKey;
  entry: Work;
}
const { section, entry } = Astro.props;
const d = entry.data;
const url = href(`/${section}/${entry.id}/`);
---

<li class="entry">
  <div class="meta">
    <div class="when">{d.dateLabel}</div>
    <div>{d.type}</div>
    <div>{d.role}</div>
    {d.venue && <div>{d.venue}</div>}
    {d.location && <div>{d.location}</div>}
  </div>
  <div>
    <h2>
      <a href={url}>{d.title}</a>
    </h2>
    <p class="summary">{d.summary}</p>
    <a class="more" href={url}>Read more</a>
  </div>
  {d.cover ? (
    <a href={url} aria-hidden="true" tabindex="-1">
      <Image class="thumb" src={d.cover} alt="" width={480} height={360} format="webp" />
    </a>
  ) : (
    <div></div>
  )}
</li>
